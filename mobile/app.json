{
  "expo": {
    "name": "ReadTrack",
    "slug": "ReadTrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/41bff96c-8830-49dc-9465-cc4f64c2858a"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#CECBF6"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.alejandro.readtrack",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#CECBF6"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      "expo-updates"
    ],
    "extra": {
      "eas": {
        "projectId": "41bff96c-8830-49dc-9465-cc4f64c2858a"
      }
    },
    "owner": "alejolarte18"
  }
}