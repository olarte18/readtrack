PORT=3000

# Token de acceso: 2h por defecto
JWT_SECRET=

# Duración del access token (string de jsonwebtoken)
JWT_ACCESS_EXPIRES=2h

# Duración del refresh token en días (rotación automática)
JWT_REFRESH_EXPIRES_DAYS=30

DB_USER=readtrack

DB_PASSWORD=

DB_HOST=localhost

DB_PORT=5432

DB_NAME=readtrack

# Required for tests — MUST point to a test database, never production
TEST_DATABASE_URL=postgresql://user:pass@localhost:5432/readtrack_test

ALLOWED_ORIGINS=https://readtrack-b3sj.onrender.com

# SSL de la BD: DB_SSL=true habilita SSL con verificación POR DEFECTO.
# SOLO para dev local con cert self-signed: DB_SSL_INSECURE=true.
# En producción (Supabase) definí DB_CA_CERT con el CA bundle.
DB_SSL=false
DB_SSL_INSECURE=false
# DB_CA_CERT=-----BEGIN CERTIFICATE-----\n...

# npm run db:setup NUNCA aplica el schema a producción sin esta bandera
# ALLOW_SCHEMA_ON_PROD=true

# Aplica el schema al arrancar el server (dev/test por defecto; en producción
# requiere AUTO_MIGRATE=true explícito)
# AUTO_MIGRATE=true

# Rate limiting por usuario en rutas autenticadas (global) y por IP en /books
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_BOOKS=60

GOOGLE_BOOKS_API_KEY=

# Recuperación de contraseña: Brevo (https://brevo.com) — no requiere dominio propio,
# solo verificar un email remitente con OTP. En dev el código se envía a DEV_EMAIL.
BREVO_API_KEY=
EMAIL_FROM=tu-email-verificado@ejemplo.com
# En dev (fuera de producción) el código va a este correo, no al del usuario
DEV_EMAIL=